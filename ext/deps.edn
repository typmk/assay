;; assay-ext — the things that are NOT "observe a running JVM":
;;   diagnose  compile-time cost notes   (different input, different lifecycle)
;;   control   trace + JDI restarts      (a debugger)
;;   native    FFM safety tiers          (a different domain)
;;   flow      FlowStorm bridge          (an optional peer tool)
;;   trace     Sayid bridge              (function value tracing)
;;   remote    JDI over a socket         (the CDT architecture)
;;   nrepl     the op-contract seam      (source-loaded middleware, not AOT'd)
;; They ride on assay's model but are not needed to use it. AOT'd into the
;; always-on jar they would load on every JVM start, so they are opt-in.
{:paths ["src"]
 :deps {dev/assay {:local/root "../assay"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {nrepl/nrepl                               {:mvn/version "1.3.1"}
                               criterium/criterium                       {:mvn/version "0.4.6"}
                               com.clojure-goes-fast/clj-java-decompiler {:mvn/version "0.3.7"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  ;; clj -X:test runs the fast lane; clj -X:test :excludes '[]' runs all
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:excludes [:slow]}}}}
