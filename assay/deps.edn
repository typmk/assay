;; assay — observe a running JVM. The essential library.
;; No editor, no debugger, no FFM, no FlowStorm. Facts and queries.
{:paths ["src"]
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {criterium/criterium                       {:mvn/version "0.4.6"}
                               com.clojure-goes-fast/clj-async-profiler  {:mvn/version "1.8.0"}
                               com.clojure-goes-fast/clj-java-decompiler {:mvn/version "0.3.7"}
                               com.clojure-goes-fast/clj-memory-meter    {:mvn/version "0.5.0"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  ;; clj -X:test runs the fast lane; clj -X:test :excludes '[]' runs all
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:excludes [:slow]}}}}
